{
  "name": "markflow",
  "version": "0.1.0",
  "private": true,
  "description": "MarkFlow — PostgreSQL 单存储的实时协同 Markdown 笔记系统（Typora 风格所见即所得）",
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @markflow/server --filter @markflow/web dev",
    "dev:server": "pnpm --filter @markflow/server dev",
    "dev:web": "pnpm --filter @markflow/web dev",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "typecheck": "pnpm -r typecheck",
    "start": "pnpm --filter @markflow/server start"
  }
}
