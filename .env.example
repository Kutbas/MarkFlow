# ===== MarkFlow 配置（复制为 .env 后修改）=====

# 监听端口（HTTP 与 WebSocket 共用同一端口）
PORT=8080

# 监听地址：IPv6 全零地址 "::" = 双栈监听（内核自动兼容 IPv4-mapped 入站）
HOST=::

# Markdown 笔记根目录（Docker 部署时挂载宿主机目录，如 /data/notes）
NOTES_DIR=./data/notes

# Typora CSS 主题目录（Docker 部署时挂载宿主机目录）
THEMES_DIR=./data/themes

# JWT 签名密钥：生产环境必须改成长随机串（生成：openssl rand -hex 32）
JWT_SECRET=change-me-to-a-long-random-string

# 账号列表：用户名:密码 或 用户名:bcrypt哈希（$2a$ 开头自动识别），逗号分隔
# 生成哈希：pnpm --filter @markflow/server run hash -- 你的密码
AUTH_USERS=admin:admin123,alice:alice123

# 协同落盘防抖：停止输入 1500ms 后写盘，或最长每 5000ms 强制写一次（PRD 规格）
FLUSH_DEBOUNCE_WAIT_MS=1500
FLUSH_DEBOUNCE_MAX_WAIT_MS=5000

# 前端构建产物目录（生产模式下由 Express 直接托管；开发模式走 Vite 5173 代理）
WEB_DIST=../web/dist

# ===== 存储（PostgreSQL）=====
# 必填：PostgreSQL 连接串（Docker 部署时由 compose 注入）
DATABASE_URL=postgres://markflow:markflow@localhost:5432/markflow
