{
  "name": "@markflow/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MarkFlow 服务端：Express + Hocuspocus 协同 + Chokidar 监听 + Puppeteer 导出",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "hash": "tsx src/scripts/hash.ts"
  },
  "dependencies": {
    "@hocuspocus/server": "^4.7.0",
    "bcryptjs": "^3.0.3",
    "chokidar": "^5.0.0",
    "express": "^5.2.1",
    "jose": "^6.2.12",
    "markdown-it": "^14.1.0",
    "prosemirror-model": "^1.25.12",
    "puppeteer": "^25.12.0",
    "y-prosemirror": "^1.3.7",
    "yjs": "^13.6.33"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^24.10.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
